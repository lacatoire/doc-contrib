<?xml version="1.0" encoding="utf-8"?>
<!--

Links into the main PHP manual on php.net, for cross-references whose
targets live in the main manual rather than in this extension manual.

Each entity carries its own namespace declarations so it stays valid
wherever it is expanded.

-->

<!ENTITY link.install.pecl '<link xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="https://www.php.net/manual/en/install.pecl.php">Installation of PECL extensions</link>'>

<!ENTITY link.install.windows.building '<link xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="https://www.php.net/manual/en/install.windows.building.php">building on Windows</link>'>

<!ENTITY link.book.libxml '<link xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="https://www.php.net/manual/en/book.libxml.php">libxml</link>'>

<!ENTITY link.ref.mcrypt '<link xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="https://www.php.net/manual/en/ref.mcrypt.php">mcrypt</link>'>

<!ENTITY link.ref.mhash '<link xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="https://www.php.net/manual/en/ref.mhash.php">mhash</link>'>
